{
  "name": "cdk",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk:deploy": "npm run clean && npm run build && cdk deploy --all",
    "cdk:deploy:ci": "npm run clean && npm run build && cdk deploy --all --require-approval never",
    "cdk:destroy": "cdk destroy --all",
    "cdk:diff": "cdk diff",
    "cdk:synth": "cdk synth --quiet",
    "check": "npm run lint:ci && npm run format:ci",
    "clean": "rm -rf dist",
    "fix": "npm run lint && npm run format",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "aws-cdk": "^2.1132.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "vitest": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.261.0",
    "constructs": "^10.7.0"
  }
}
