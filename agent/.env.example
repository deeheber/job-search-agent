# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Tavily API Key (required for web search)
# Get your free API key at https://app.tavily.com (1,000 requests/month)
#
# LOCAL DEVELOPMENT: Set the key directly here
TAVILY_API_KEY=tvly-YOUR_API_KEY_HERE
#
# AWS DEPLOYMENT: The key is stored in SSM Parameter Store SecureString
# Create it with:
#   aws ssm put-parameter --name "/job-search-agent/tavily-api-key" \
#     --value "tvly-YOUR_API_KEY" --type SecureString
#
# The SSM parameter name can be customized via TAVILY_API_KEY_SSM_PARAMETER

# Bedrock Model Configuration
# Specify the Amazon Bedrock model ID to use for the agent
# If not set, uses DEFAULT_MODEL_ID from src/agentcore_app.py
# For valid model IDs, see: https://docs.aws.amazon.com/bedrock/latest/userguide/model-ids.html
# BEDROCK_MODEL_ID=your-preferred-model-id
